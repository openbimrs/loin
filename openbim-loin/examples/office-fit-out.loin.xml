          <dt:Name language="en">Acoustic rating</dt:Name>
          <dt:Definition language="en">Sound reduction the partition must achieve, in decibels.</dt:Definition>
          <dt:DataType name="REAL">
            <dt:PossibleValues>
              <dt:ValueList language="en">
                <dt:Value order="1">38</dt:Value>
                <dt:Value order="2">45</dt:Value>
                <dt:Value order="3">52</dt:Value>
              </dt:ValueList>
            </dt:PossibleValues>
          </dt:DataType>
          <dt:UnitRef dt:referenceURI="https://example.org/units/decibel"/>
        </Property>
        <Property dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a14" dateOfCreation="2026-09-01T09:00:00Z">
          <dt:Name language="en">Fire resistance</dt:Name>
          <dt:Definition language="en">Period for which the partition must resist fire, in minutes.</dt:Definition>
          <dt:DataType name="INTEGER"/>
          <dt:DimensionRef dt:referenceURI="https://example.org/dimensions/time"/>
          <dt:UnitRef dt:referenceURI="https://example.org/units/minute"/>
        </Property>
        <QuantityKind dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a30" dateOfCreation="2026-09-01T09:00:00Z">
          <dt:Name language="en">Partition height</dt:Name>
          <dt:Definition language="en">Height of a partition from finished floor to its head.</dt:Definition>
          <dt:DimensionRef dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a31"/>
        </QuantityKind>
        <GroupsOfProperties>
          <GroupOfProperties dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a15" dateOfCreation="2026-09-01T09:00:00Z">
            <dt:Name language="en">Performance</dt:Name>
            <dt:Definition language="en">Properties that drive the partition specification.</dt:Definition>
            <dt:IsSubtypeOfRef dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a92"/>
            <dt:HasPropertyRef dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a13"/>
            <dt:HasPropertyRef dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a14"/>
