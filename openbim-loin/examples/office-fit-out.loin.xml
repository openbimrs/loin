        <Definition language="en">Quantities and specifications sufficient to price the fit-out package.</Definition>
        <ReferenceDocument dt:referenceURI="https://example.org/fit-out/employer-information-requirements"/>
        <Description language="en">Used by the cost consultant for the second cost estimate.</Description>
        <Language>en-GB</Language>
        <Region>Europe</Region>
        <DictionaryRef dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a90"/>
      </Purpose>
      <InformationDeliveryMilestone dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a04" Date="2026-11-30T17:00:00+01:00">
        <Name language="en">Design freeze</Name>
        <Description language="en">Last exchange before the tender documents are issued.</Description>
        <ReferenceDocument dt:referenceURI="https://example.org/fit-out/programme#design-freeze"/>
      </InformationDeliveryMilestone>
      <ProvidingActor dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a05" firstName="Mira" middleName="A." lastName="Okafor" affiliation="Example Architects">
