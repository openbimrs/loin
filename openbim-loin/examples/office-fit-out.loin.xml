        <Detail>
          <Dictionary dt:referenceURI="https://example.org/fit-out/geometry-dictionary"/>
          <ShapeAssembly>SingleObjectSingularShape</ShapeAssembly>
          <ShapeRepresentation>OuterShellAsSingularShape</ShapeRepresentation>
          <ShapeInfluence>
            <InsideGeometry>NoInsideGeometry</InsideGeometry>
            <Connections>NoConnections</Connections>
            <Openings>OpeningsAsPartOfShape</Openings>
            <OperatingAndClearanceZones>NotRequired</OperatingAndClearanceZones>
            <Features>NoFeatures</Features>
            <ThresholdDimension>
              <Threshold>50</Threshold>
              <Unit dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a33" dateOfCreation="2026-09-01T09:00:00Z">
                <dt:Name language="en">Millimetre</dt:Name>
                <dt:Symbol language="en">mm</dt:Symbol>
                <dt:DimensionRef dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a31"/>
                <dt:Scale>LINEAR</dt:Scale>
                <dt:Base>TEN</dt:Base>
                <dt:Coefficient>1/1000</dt:Coefficient>
                <dt:Offset>0</dt:Offset>
              </Unit>
              <Definition language="en">Openings and recesses smaller than this are not modelled.</Definition>
            </ThresholdDimension>
          </ShapeInfluence>
        </Detail>
        <Dimensionality>3D</Dimensionality>
        <Appearance>SymbolicByMapping</Appearance>
        <ParametricBehaviour>NotRequested</ParametricBehaviour>
        <Location>
          <RelativeOrAbsolute>Relative</RelativeOrAbsolute>
          <ReferenceObject>Level 3 structural grid</ReferenceObject>
        </Location>
      </GeometricalInformation>
