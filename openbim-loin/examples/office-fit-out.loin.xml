    <SpecificationPerObjectType dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a10" dt:about="https://example.org/fit-out/loin/partition" dateOfCreation="2026-09-01T09:00:00Z">
      <dt:Name language="en">Partition walls for cost planning</dt:Name>
      <dt:Definition language="en">Information required about non-load-bearing internal partitions.</dt:Definition>
      <ObjectType dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a11" dateOfCreation="2026-09-01T09:00:00Z">
        <dt:Name language="en">Partition wall</dt:Name>
        <dt:Definition language="en">A non-load-bearing wall that divides internal space.</dt:Definition>
        <dt:IsSubtypeOfRef dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a91"/>
      </ObjectType>
      <AlphanumericalInformation dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a12">
