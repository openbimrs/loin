          <dt:Name language="en">Example acoustic design guide</dt:Name>
          <dt:Language>en</dt:Language>
          <dt:Publisher>Example Acoustics Society</dt:Publisher>
          <dt:URI>https://example.org/guides/acoustic-design</dt:URI>
        </ReferenceDocument>
        <Dimension dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a31" dateOfCreation="2026-09-01T09:00:00Z">
