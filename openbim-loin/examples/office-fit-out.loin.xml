        <Description language="en">Authors the architectural model.</Description>
        <EMailAddress>mira.okafor@architects.example</EMailAddress>
      </ProvidingActor>
      <ReceivingActor dt:GUID="5f0c1a2e-3b4d-4e6f-8a9b-0c1d2e3f4a06" firstName="Jonas" middleName="P." lastName="Lindqvist" affiliation="Example Cost Consultants">
